{
  "expo": {
    "name": "StuddyPebble",
    "slug": "studdypebble",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "studdypebble",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ananthroy.studdypebble",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "StuddyPebble lets you attach images to your flashcards.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ananthroy.studdypebble"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7c6f34d6-e288-4713-8720-fb0748d48b9a"
      }
    }
  }
}
