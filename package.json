{
  "name": "flashy",
  "version": "1.0.0",
  "description": "A stunning Quizlet clone with flashcards, groups, quizzes, and image support",
  "main": "electron/main.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run server\" \"cd client && npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "cd client && npm run build && cd .. && electron-builder",
    "db:init": "node server/config/init-db.js",
    "install:all": "npm install && cd client && npm install"
  },
  "build": {
    "appId": "com.flashy.app",
    "productName": "Flashy",
    "files": [
      "client/dist/**/*",
      "server/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "sql.js": "^1.14.1",
    "uuid": "^10.0.0",
    "yauzl": "^3.2.1"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "wait-on": "^8.0.1"
  }
}
